{
  "name": "structura-mvp",
  "displayName": "Structura - Code Graph Navigator",
  "description": "Turn your codebase into sci-fi feel code exploration graph. Navigate your code like never before. With keyboard-shortcuts or with the mice",
  "publisher": "AhmedRakan",
  "author": {
    "name": "Ahmed Rakan"
  },
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Visualization"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:structura.showGraph",
    "onCommand:structura.refreshGraph"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ARAldhafeeri/structura-v2.git"
  },
  "pricing": "Free",
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "structura.showGraph",
        "title": "Structura: Show Code Graph",
        "icon": "$(graph)"
      },
      {
        "command": "structura.refreshGraph",
        "title": "Structura: Refresh Graph"
      }
    ],
    "keybindings": [
      {
        "command": "structura.showGraph",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g"
      }
    ],
    "configuration": {
      "title": "Structura",
      "properties": {
        "structura.baseDirectory": {
          "type": "string",
          "default": "",
          "description": "Base directory to analyze (leave empty for workspace root)"
        },
        "structura.ignorePatterns": {
          "type": "array",
          "default": [
            "node_modules",
            "dist",
            "build",
            ".git"
          ],
          "description": "Patterns to ignore when analyzing"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --platform=node --external:vscode --external:onnxruntime-node --external:oxc-parser",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && vscode-test",
    "package": "npm run build && vsce package"
  },
  "devDependencies": {
    "@types/deep-diff": "^1.0.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.3.3",
    "@types/sinon": "^21.0.0",
    "@types/vscode": "^1.75.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "sinon": "^21.0.2",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@babel/parser": "^7.23.0",
    "@chroma-core/default-embed": "^0.1.9",
    "@parcel/watcher": "^2.5.6",
    "@typescript-eslint/parser": "^6.0.0",
    "bullmq": "^5.71.0",
    "chromadb": "^3.3.3",
    "deep-diff": "^1.0.2",
    "esrap": "^2.2.3",
    "oxc-parser": "^0.115.0",
    "uuid": "^13.0.0"
  }
}
